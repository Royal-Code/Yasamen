{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "allowImportingTsExtensions": false
  },
  "include": ["src/lib", "src/vite-env.d.ts"],
  "exclude": ["src/lib/**/__tests__/**", "src/lib/**/*.spec.*", "src/lib/**/*.test.*"]
}
